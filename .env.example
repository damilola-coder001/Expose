# ==============================================================================
# EXPOSE Security Intelligence Platform - Environment Variables Template
# ==============================================================================
# Copy this file to .env for local deployment: cp .env.example .env
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit your actual .env file or real secrets to version control.
# 2. NEVER expose these backend secrets to client-side frontend code.
# 3. AI_API_KEY is used for the security research provider (e.g. Gemini / Claude).
#    These are NOT Nuclei API keys. Nuclei itself is an offline scanner component.
# ==============================================================================

# Core Database Storage (PostgreSQL)
# Use a managed database URL with TLS in production. Never use placeholder
# credentials or sslmode=disable outside local development.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/expose?sslmode=require

# Distributed Job Queue & Rate Limiting Cache (Redis)
REDIS_URL=redis://USERNAME:PASSWORD@HOST:6379/0

# AI Security Intelligence & Grounded Web Research
# (Gemini API key for grounded CVE/OWASP analysis; not required for mock provider in offline tests)
AI_API_KEY=your_gemini_or_anthropic_api_key_here

# Object Storage / Evidence Archive (S3 / MinIO / Cloud Storage)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_BUCKET_NAME=expose-evidence
S3_REGION=us-east-1

# Application Server Settings
PORT=8000
HOST=127.0.0.1
# Set ENV=production on Vercel. When VERCEL_ENV=production is present, Expose
# also defaults to production mode automatically, disabling docs/OpenAPI.
ENV=production
LOG_LEVEL=info

# Leave blank for the integrated same-origin Vercel deployment. Set explicit,
# comma-separated HTTPS origins only if a separate frontend must call this API.
# CORS_ALLOWED_ORIGINS=https://app.example.com

# Rate Limiting & Abuse Prevention (Phase 18)
EXPOSE_RATE_LIMIT_PER_MINUTE=10
EXPOSE_RATE_LIMIT_PER_HOUR=60
EXPOSE_TARGET_COOLDOWN_SECONDS=30
EXPOSE_MAX_CONCURRENT_SCANS=5
EXPOSE_MAX_QUEUE_DEPTH=50
EXPOSE_SCAN_TIMEOUT_SECONDS=45
EXPOSE_ALLOW_PRIVATE=false

# Scanner Worker Isolation (Phase 19)
BROWSER_WORKER_URL=http://localhost:3001
WORKER_MAX_MEMORY_MB=512
WORKER_CPU_QUOTA=1.0
