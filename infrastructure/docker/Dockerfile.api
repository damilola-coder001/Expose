# Multi-stage Dockerfile for Go API Server
FROM golang:1.22-alpine AS builder

WORKDIR /app

# Copy Go module files
COPY apps/api/go.mod ./
RUN go mod download || true

# Copy API server source code
COPY apps/api/ ./

# Run automated test suite during container build
RUN CGO_ENABLED=0 go test -v ./...

# Build statically compiled binary
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-w -s" -o /app/expose-api ./cmd/server

# Production minimal runtime
FROM alpine:3.20

RUN apk add --no-cache ca-certificates curl bind-tools

WORKDIR /app

COPY --from=builder /app/expose-api /app/expose-api

EXPOSE 8080

USER 1000:1000

HEALTHCHECK --interval=5s --timeout=3s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

ENTRYPOINT ["/app/expose-api"]
