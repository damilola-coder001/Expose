# ==============================================================================
# EXPOSE - Environment Configuration (.env.example)
# ==============================================================================

# Core Application
ENV=development
LOG_LEVEL=info
SERVICE_NAME=expose-api

# API Server Networking
PORT=8080
READ_TIMEOUT_SECONDS=15
WRITE_TIMEOUT_SECONDS=30
IDLE_TIMEOUT_SECONDS=60
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Database
DATABASE_URL=postgres://expose:expose_secure_pass@localhost:5432/expose?sslmode=disable
POSTGRES_USER=expose
POSTGRES_PASSWORD=expose_secure_pass
POSTGRES_DB=expose
POSTGRES_PORT=5432

# Redis Queue & Cache
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Specialized Services
BROWSER_WORKER_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8080

# Safety & Rate Limiting Controls
RATE_LIMIT_REQUESTS_PER_SECOND=5.0
RATE_LIMIT_BURST=10
BLOCK_PRIVATE_IPS=true
MAX_SCAN_TIMEOUT_SECONDS=45
