# Build stage
FROM golang:1.22-alpine AS builder

WORKDIR /app

# Copy dependency specifications
COPY go.mod go.sum* ./
RUN go mod download || true

# Copy source code
COPY . .

# Build statically linked binary
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-w -s" -o /app/expose-server ./cmd/server

# Final runtime image
FROM alpine:3.20

RUN apk add --no-cache ca-certificates bind-tools curl

WORKDIR /app

COPY --from=builder /app/expose-server /app/expose-server

EXPOSE 8080

USER 1000:1000

ENTRYPOINT ["/app/expose-server"]
